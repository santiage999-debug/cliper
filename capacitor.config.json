{
  "appId": "com.cliper.app",
  "appName": "Cliper",
  "webDir": "dist",
  "android": {
    "allowMixedContent": false,
    "backgroundColor": "#07070c"
  },
  "server": {
    "androidScheme": "https"
  },
  "plugins": {
    "CapacitorHttp": {
      "enabled": false
    },
    "SystemBars": {
      "insetsHandling": "css",
      "initialViewportFitValueHint": "cover",
      "style": "DARK"
    }
  }
}